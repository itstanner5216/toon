# CQADupStack sub-forums (evaluated individually and averaged)
CQADUPSTACK_FORUMS = [
    "android", "english", "gaming", "gis", "mathematica",
    "physics", "programmers", "stats", "tex", "unix",
    "webmasters", "wordpress",
]

LARGE_THRESHOLD = 1_000_000


def download_dataset(name: str) -> str:
    """Download a BEIR dataset and return the path."""
    DATA_DIR.mkdir(exist_ok=True)
    dataset_path = DATA_DIR / name
    if dataset_path.exists():
        print(f"  [cached] {name}")
        return str(dataset_path)

    url = f"https://public.ukp.informatik.tu-darmstadt.de/thakur/BEIR/datasets/{name}.zip"
    print(f"  [downloading] {name}...")
    dl_path = beir_util.download_and_unzip(url, str(DATA_DIR))
    return dl_path


def load_dataset(name: str, split: str = "test"):
    """Load corpus, queries, and qrels for a BEIR dataset."""
    path = download_dataset(name)
    corpus, queries, qrels = GenericDataLoader(
        data_folder=path).load(
        split=split)
    return corpus, queries, qrels


def load_cqadupstack():
    """Load CQADupStack — downloads once, returns list of (forum_name, corpus, queries, qrels)."""
    DATA_DIR.mkdir(exist_ok=True)
    base = DATA_DIR / "cqadupstack"

    if not base.exists():
        url = "https://public.ukp.informatik.tu-darmstadt.de/thakur/BEIR/datasets/cqadupstack.zip"
        print(f"  [downloading] cqadupstack...")
        beir_util.download_and_unzip(url, str(DATA_DIR))
    else:
        print(f"  [cached] cqadupstack")

    forums = []
    for forum in CQADUPSTACK_FORUMS:
        forum_path = base / forum
        if forum_path.exists():
            corpus, queries, qrels = GenericDataLoader(
                data_folder=str(forum_path)).load(split="test")
            forums.append((forum, corpus, queries, qrels))
        else:
            print(f"    ⚠ sub-forum '{forum}' not found, skipping")
    return forums


def build_chunks(corpus: dict) -> list[dict]:
    """Convert BEIR corpus to our chunk format."""
    chunks = []
    for doc_id, doc in corpus.items():
        text = doc.get("title", "") + " " + doc.get("text", "")
        chunks.append({"chunk_id": str(doc_id), "text": text.strip()})
    return chunks


def validate_corpus_size(name: str, actual: int, expected_hint: str):
    """Abort if corpus size is wildly different from expected — catches dataset loading bugs."""
    hint = expected_hint.replace("K", "e3").replace("M", "e6")
    try:
        expected = float(hint)
    except ValueError:
        return  # Can't parse hint, skip check
    if actual < expected * 0.8 or actual > expected * 1.5:
        raise ValueError(
            f"Corpus size mismatch for '{name}': expected ~{expected_hint} "
            f"({expected:,.0f}) but got {actual:,}. "
            f"Aborting to prevent benchmarking the wrong data."
        )


def evaluate_index(
        index,
        queries: dict,
        top_k: int = 100,
        num_workers: int = 1,
        timeout_per_query: float = 300.0):
    """Run all queries with fork+COW parallelism and watchdog timeout."""
    if num_workers <= 1:
        results = {}
        start = time.perf_counter()
        for qid, query_text in queries.items():
            hits = index.search(query_text, top_k=top_k)
            results[qid] = {doc_id: float(score) for doc_id, score in hits}
        elapsed = time.perf_counter() - start
        return results, elapsed

    global _SHARED_INDEX
    _SHARED_INDEX = index

    tasks = [(qid, text, top_k) for qid, text in queries.items()]
    total_timeout = timeout_per_query * len(tasks)

    results = {}
    start = time.perf_counter()
    last_result_time = time.perf_counter()

    ctx = mp.get_context("fork")
    try:
        with ctx.Pool(num_workers, initializer=_worker_init) as pool:
            # chunksize=1 required — chunksize>1 returns a plain generator
            # that lacks .next(timeout=) for stall detection
            it = pool.imap_unordered(_search_one, tasks, chunksize=1)

            while True:
                try:
                    qid, hits = it.next(timeout=timeout_per_query)
                    results[qid] = hits
                    last_result_time = time.perf_counter()

                    # Progress logging
                    if len(results) % 500 == 0 or len(results) == len(tasks):
                        elapsed = time.perf_counter() - start
                        qps = len(results) / elapsed if elapsed > 0 else 0
                        print(f"    {len(results)}/{len(tasks)} queries | "
                              f"{qps:.1f} q/s | {elapsed:.0f}s elapsed")

                except StopIteration:
                    break
                except mp.TimeoutError:
                    stall_time = time.perf_counter() - last_result_time
                    total_elapsed = time.perf_counter() - start

                    if total_elapsed > total_timeout:
                        print(
                            f"  ⚠️ TOTAL TIMEOUT after {
                                total_elapsed:.0f}s — " f"got {
                                len(results)}/{
                                len(tasks)} queries")
                        pool.terminate()
                        notify(
                            "⚠️ Query pool timeout",
                            f"Timed out after {total_elapsed:.0f}s\n"
                            f"Got {len(results)}/{len(tasks)} queries\n"
                            f"Stalled for {stall_time:.0f}s",
                            priority="high",
                        )
                        break
                    else:
                        print(f"    ⚠️ No result for {stall_time:.0f}s "
                              f"({len(results)}/{len(tasks)} done) — still waiting...")
    finally:
        _SHARED_INDEX = None

    elapsed = time.perf_counter() - start
    return results, elapsed


def compute_metrics(results: dict, qrels: dict) -> dict:
    """Compute NDCG@10 and Recall@100 via pytrec_eval."""
    filtered_qrels = {
        qid: rels for qid,
        rels in qrels.items() if qid in results}
    if not filtered_qrels:
        return {"ndcg@10": 0.0, "recall@100": 0.0, "num_queries": 0}

    evaluator = pytrec_eval.RelevanceEvaluator(
        filtered_qrels, {"ndcg_cut_10", "recall_100"})
    scores = evaluator.evaluate(results)

    ndcg_values = [s["ndcg_cut_10"] for s in scores.values()]
    recall_values = [s["recall_100"] for s in scores.values()]

    return {
        "ndcg@10": sum(ndcg_values) /
        len(ndcg_values) if ndcg_values else 0.0,
        "recall@100": sum(recall_values) /
        len(recall_values) if recall_values else 0.0,
        "num_queries": len(filtered_qrels),
    }


def run_single_benchmark(
        chunks: list[dict],
        queries: dict,
        qrels: dict,
        label: str,
        max_queries: int = 0,
        num_workers: int = 1) -> dict:
    """Run BM25 vs BMX+ on a single corpus/query set. Returns result dict.

    NOTE: accepts pre-built chunks (not raw corpus) so the caller can free the
    BEIR corpus dict before this function runs, saving ~10-15GB peak RAM.
    Chunks are reused for both indexes — build_index must not mutate them.
    """
    # Subsample queries if max_queries is set
    if max_queries > 0 and len(queries) > max_queries:
        # Sort before sampling for reproducibility across machines/dict orders
        valid_qids = sorted(qid for qid in queries if qid in qrels)
        random.seed(42)
        sampled_qids = random.sample(
            valid_qids, min(
                max_queries, len(valid_qids)))
        queries = {qid: queries[qid] for qid in sampled_qids}
        qrels = {qid: qrels[qid] for qid in sampled_qids if qid in qrels}
        print(
            f"  Subsampled to {
                len(queries)} queries (from {
                len(valid_qids)} with qrels, seed=42)")

    corpus_size = len(chunks)
    num_queries = len(queries)
    w = num_workers

    if w > 1:
        print(f"  ⚡ Parallel mode: {w} workers (fork + COW)")

    result = {
        "dataset": label,
        "corpus_size": corpus_size,
        "num_queries": num_queries,
        "workers": w}

    # ── BM25 ──
    print(f"  Building BM25 index ({corpus_size:,} docs)...")
    bm25 = BM25Index()
    t0 = time.perf_counter()
    bm25.build_index(chunks)
    bm25_build = time.perf_counter() - t0
    print(
        f"  BM25 index built in {
            bm25_build:.1f}s | RSS: {
            get_rss_gb():.1f} GB")

    print(f"  Running BM25 queries ({num_queries:,} queries)...")
    bm25_results, bm25_time = evaluate_index(bm25, queries, num_workers=w)
    bm25_metrics = compute_metrics(bm25_results, qrels)
    bm25_qps = num_queries / bm25_time if bm25_time > 0 else 0

    result["bm25"] = {
        **bm25_metrics,
        "total_time": bm25_time,
        "qps": bm25_qps,
        "build_time": bm25_build}
    print(
        f"  BM25 — NDCG@10: {bm25_metrics['ndcg@10']:.4f} | Recall@100: {bm25_metrics['recall@100']:.4f} | {bm25_qps:.1f} q/s")

    # Free BM25 memory before building BMX+
    del bm25, bm25_results
    gc.collect()
    print(f"  [mem] After BM25 cleanup: {get_rss_gb():.1f} GB RSS")

    # ── BMX+ ──
    print(f"  Building BMX+ index ({corpus_size:,} docs)...")
    bmx = BMXPlusIndex()
    t0 = time.perf_counter()
    bmx.build_index(chunks)  # Reuse same chunks — no rebuild needed
    bmx_build = time.perf_counter() - t0
    print(
        f"  BMX+ index built in {bmx_build:.1f}s | RSS: {get_rss_gb():.1f} GB")

    print(f"  Running BMX+ queries ({num_queries:,} queries)...")
    bmx_results, bmx_time = evaluate_index(bmx, queries, num_workers=w)
    bmx_metrics = compute_metrics(bmx_results, qrels)
    bmx_qps = num_queries / bmx_time if bmx_time > 0 else 0

    result["bmx"] = {
        **bmx_metrics,
        "total_time": bmx_time,
        "qps": bmx_qps,
        "build_time": bmx_build}
    print(
        f"  BMX+ — NDCG@10: {bmx_metrics['ndcg@10']:.4f} | Recall@100: {bmx_metrics['recall@100']:.4f} | {bmx_qps:.1f} q/s")

    # Free BMX+ memory
    del bmx, bmx_results
    gc.collect()
    print(f"  [mem] After BMX+ cleanup: {get_rss_gb():.1f} GB RSS")

    # ── Delta ──
    ndcg_delta = bmx_metrics["ndcg@10"] - bm25_metrics["ndcg@10"]
    recall_delta = bmx_metrics["recall@100"] - bm25_metrics["recall@100"]
    speedup = bmx_qps / bm25_qps if bm25_qps > 0 else 0

    sign_n = "+" if ndcg_delta >= 0 else ""
    sign_r = "+" if recall_delta >= 0 else ""
    print(
        f"  Δ NDCG@10: {sign_n}{
            ndcg_delta:.4f} | Δ Recall@100: {sign_r}{
            recall_delta:.4f} | Speedup: {
                speedup:.2f}×")

    result["delta"] = {
        "ndcg@10": ndcg_delta,
        "recall@100": recall_delta,
        "speedup": speedup}
    result["timestamp"] = time.strftime("%Y-%m-%d %H:%M:%S")

    return result


def save_results(all_results: list[dict]):
    """Atomic save — write to temp file, fsync, then rename. Safe against OOM-kill mid-write."""
    tmp = RESULTS_FILE.with_suffix(".tmp")
    with open(tmp, "w") as f:
        json.dump(all_results, f, indent=2)
        f.flush()
        os.fsync(f.fileno())
    tmp.rename(RESULTS_FILE)  # Atomic on same filesystem
    print(f"  💾 Results saved to {RESULTS_FILE}")
    offload_results()


def load_existing_results() -> list[dict]:
    """Load previously saved results for --resume."""
    if RESULTS_FILE.exists():
        with open(RESULTS_FILE) as f:
            return json.load(f)
    return []


def print_summary_table(all_results: list[dict]):
    """Print publication-ready comparison table."""
    print(f"\n\n{'=' * 110}")
    print("  FULL BEIR BENCHMARK RESULTS — BM25 vs BMX+ (Entropy-Weighted TAAT)")
    print(f"{'=' * 110}")
    print()

    header = f"{
        'Dataset':<20} {
        'Docs':>9} {
            'Qs':>6} │ {
                'BM25 NDCG':>10} {
                    'BMX+ NDCG':>10} {
                        'Δ':>8} │ {
                            'BM25 R@100':>10} {
                                'BMX+ R@100':>10} {
                                    'Δ':>8} │ {
                                        'BM25 q/s':>8} {
                                            'BMX+ q/s':>8} {
                                                'Speed':>6}"
    print(header)
    print("─" * len(header))

    total_bm25_ndcg = total_bmx_ndcg = 0
    total_bm25_recall = total_bmx_recall = 0
    n = 0

    for r in all_results:
        bm25 = r["bm25"]
        bmx = r["bmx"]
        d = r["delta"]
        sign_n = "+" if d["ndcg@10"] >= 0 else ""
        sign_r = "+" if d["recall@100"] >= 0 else ""

        print(
            f"{r['dataset']:<20} {r['corpus_size']:>9,} {r['num_queries']:>6} │ "
            f"{bm25['ndcg@10']:>10.4f} {bmx['ndcg@10']:>10.4f} {sign_n}{d['ndcg@10']:>7.4f} │ "
            f"{bm25['recall@100']:>10.4f} {bmx['recall@100']:>10.4f} {sign_r}{d['recall@100']:>7.4f} │ "
            f"{bm25['qps']:>8.1f} {bmx['qps']:>8.1f} {d['speedup']:>5.2f}×"
        )

        total_bm25_ndcg += bm25["ndcg@10"]
        total_bmx_ndcg += bmx["ndcg@10"]
        total_bm25_recall += bm25["recall@100"]
        total_bmx_recall += bmx["recall@100"]
        n += 1

    if n > 0:
        avg_bm25_ndcg = total_bm25_ndcg / n
        avg_bmx_ndcg = total_bmx_ndcg / n
        avg_bm25_recall = total_bm25_recall / n
        avg_bmx_recall = total_bmx_recall / n
        avg_ndcg_delta = avg_bmx_ndcg - avg_bm25_ndcg
        avg_recall_delta = avg_bmx_recall - avg_bm25_recall

        sign_n = "+" if avg_ndcg_delta >= 0 else ""
        sign_r = "+" if avg_recall_delta >= 0 else ""

        print("─" * len(header))
        print(
            f"{
                'AVERAGE':<20} {
                '':>9} {
                '':>6} │ " f"{
                    avg_bm25_ndcg:>10.4f} {
                        avg_bmx_ndcg:>10.4f} {sign_n}{
                            avg_ndcg_delta:>7.4f} │ " f"{
                                avg_bm25_recall:>10.4f} {
                                    avg_bmx_recall:>10.4f} {sign_r}{
                                        avg_recall_delta:>7.4f} │ " f"{
                                            '':>8} {
                                                '':>8} {
                                                    '':>6}")

    print()
    print(f"  Datasets evaluated: {n}")
    print(f"  NDCG@10 = Normalized Discounted Cumulative Gain (ranking quality)")
    print(f"  R@100   = Recall at 100 (retrieval coverage)")
    print(f"  q/s     = Queries per second (throughput)")
    print()


def run_dataset(
        ds: dict,
        all_results: list[dict],
        max_queries: int,
        num_workers: int):
    """Run a single dataset end-to-end. All large objects are scoped here so they're
    freed when this function returns (or raises), preventing leaks across datasets."""
    name = ds["name"]

    check_disk_space(min_gb=10.0)

    notify(
        f"🔄 Starting {name}",
        f"Corpus: ~{ds['docs']} docs | Domain: {ds['domain']}\n"
        f"RSS: {get_rss_gb():.1f}GB | Datasets done: {len(all_results)}",
    )

    print("  Loading dataset...")
    corpus, queries, qrels = load_dataset(name, split=ds["split"])

    # Hard abort if corpus size doesn't match expected — catches dataset
    # loading bugs
    validate_corpus_size(name, len(corpus), ds["docs"])

    # Build chunks once, free the raw BEIR corpus dict to save ~10-15GB peak
    # RAM
    chunks = build_chunks(corpus)
    del corpus
    gc.collect()
    print(
        f"  [mem] After corpus→chunks: {
            get_rss_gb():.1f} GB RSS ({
            len(chunks):,} chunks)")

    result = run_single_benchmark(
        chunks,
        queries,
        qrels,
        name,
        max_queries=max_queries,
        num_workers=num_workers)

    # Explicit cleanup of everything large
    del chunks, queries, qrels
    gc.collect()

    return result


def main():
    parser = argparse.ArgumentParser(
        description="Full BEIR Benchmark: BM25 vs BMX+")
    parser.add_argument("--datasets", nargs="+", default=None,
                        help="Specific datasets to run (default: all)")
    parser.add_argument("--skip-large", action="store_true",
                        help="Skip datasets with > 1M docs")
    parser.add_argument("--resume", action="store_true",
                        help="Skip datasets already in results file")
    parser.add_argument("--no-cqadupstack", action="store_true",
                        help="Skip CQADupStack (12 sub-forums)")
    parser.add_argument(
        "--max-queries",
        type=int,
        default=0,
        help="Max queries per dataset (0 = all). Subsampled with seed=42 for reproducibility.")
    parser.add_argument(
        "--notify",
        type=str,
        default=None,
        help="ntfy.sh topic name for push notifications (e.g., 'bmx-benchmarks')")
    parser.add_argument(
        "--offload",
        type=str,
        default=None,
        help="SCP target for incremental results offload (e.g., 'user@home:/path/results/')")
    parser.add_argument(
        "--parallel",
        type=int,
        default=1,
        help="Number of parallel query workers (default: 1). Uses fork+COW to share index without duplicating RAM.")
    args = parser.parse_args()

    global NTFY_TOPIC, OFFLOAD_TARGET
    NTFY_TOPIC = args.notify
    OFFLOAD_TARGET = args.offload

    print("╔════════════════════════════════════════════════════════════════╗")
    print("║     FULL BEIR BENCHMARK — BM25 vs BMX+ (Entropy-Weighted)    ║")
    print("║     All publicly available datasets • Incremental saving     ║")
    print("╚════════════════════════════════════════════════════════════════╝")
    print()
    print(f"  Workers:      {args.parallel}")
    print(f"  Max queries:  {args.max_queries or 'all'}")
    print(f"  Notify:       {NTFY_TOPIC or 'disabled'}")
    print(f"  Offload:      {OFFLOAD_TARGET or 'disabled'}")
    print(f"  Results file: {RESULTS_FILE}")
    print(f"  RAM:          {get_rss_gb():.1f} GB RSS (startup)")
    check_disk_space()

    # Load existing results if resuming
    all_results = load_existing_results() if args.resume else []
    completed_names = {r["dataset"] for r in all_results}

    if args.resume and completed_names:
        print(
            f"\n  Resuming — {
                len(completed_names)} datasets already complete: {
                ', '.join(
                    sorted(completed_names))}")

    # Determine which datasets to run (preserve user-specified order)
    if args.datasets:
        ds_lookup = {d["name"]: d for d in ALL_DATASETS}
        datasets_to_run = [ds_lookup[name]
                           for name in args.datasets if name in ds_lookup]
        # Warn about unknown dataset names
        unknown = [
            name for name in args.datasets if name not in ds_lookup and name != "cqadupstack"]
        if unknown:
            print(f"  ⚠️ Unknown datasets ignored: {', '.join(unknown)}")
    else:
        datasets_to_run = ALL_DATASETS

    total_start = time.perf_counter()

    notify(
        "🚀 Benchmark starting",
        f"Datasets: {len(datasets_to_run)} | Workers: {args.parallel} | "
        f"Max queries: {args.max_queries or 'all'}\n"
        f"RSS: {get_rss_gb():.1f}GB",
    )

    # ── Run standard datasets ──
    for i, ds in enumerate(datasets_to_run):
        name = ds["name"]

        if name in completed_names:
            print(f"\n  ⏭ {name} — already completed, skipping")
            continue

        if args.skip_large:
            doc_hint = ds["docs"].replace(
                "K",
                "000").replace(
                "M",
                "000000").replace(
                ".",
                "")
            try:
                if int(doc_hint) > LARGE_THRESHOLD:
                    print(
                        f"\n  ⏭ {name} — skipped (>{
                            LARGE_THRESHOLD /
                            1e6:.0f}M docs, use without --skip-large)")
                    continue
            except ValueError:
                pass

        print(f"\n{'=' * 70}")
        print(f"  BEIR Dataset: {name}  ({ds['docs']} docs, {ds['domain']})")
        print(
            f"  [{i + 1}/{len(datasets_to_run)}] | Elapsed: {(time.perf_counter() - total_start) / 60:.1f}m")
        print(f"{'=' * 70}")

        try:
            result = run_dataset(ds, all_results, max_queries=args.max_queries,
                                 num_workers=args.parallel)
            all_results.append(result)
            completed_names.add(name)
            save_results(all_results)

            # Notify success with full scores
            d = result["delta"]
            bm25 = result["bm25"]
            bmx = result["bmx"]
            sign_n = "+" if d["ndcg@10"] >= 0 else ""
            sign_r = "+" if d["recall@100"] >= 0 else ""
            elapsed_min = (time.perf_counter() - total_start) / 60
            notify(
                f"✅ {name} — {result['corpus_size']:,} docs",
                f"BM25  NDCG: {bm25['ndcg@10']:.4f} | R@100: {bm25['recall@100']:.4f} | {bm25['qps']:.1f} q/s\n"
                f"BMX+  NDCG: {bmx['ndcg@10']:.4f} | R@100: {bmx['recall@100']:.4f} | {bmx['qps']:.1f} q/s\n"
                f"────────────────────────\n"
                f"Δ NDCG: {sign_n}{d['ndcg@10']:.4f} | Δ R@100: {sign_r}{d['recall@100']:.4f} | Speed: {d['speedup']:.1f}×\n"
                f"RSS: {get_rss_gb():.1f} GB | Elapsed: {elapsed_min:.0f}m\n"
                f"\n{len(all_results)} of {len(datasets_to_run)} datasets complete",
            )

        except Exception as e:
            err_msg = f"{type(e).__name__}: {e}"
            print(f"\n  ✗ {name} FAILED: {err_msg}")
            traceback.print_exc()
            notify(
                f"❌ {name} FAILED",
                f"{err_msg}\n\nRSS: {
                    get_rss_gb():.1f}GB",
                priority="high")
            # Save what we have and continue
            save_results(all_results)

        # Always force GC between datasets regardless of success/failure
        gc.collect()

    # ── CQADupStack (12 sub-forums, reported as average) ──
    if not args.no_cqadupstack and "cqadupstack" not in completed_names:
        if not args.datasets or "cqadupstack" in (args.datasets or []):
            print(f"\n{'=' * 70}")
            print(f"  BEIR Dataset: CQADupStack  (12 StackExchange sub-forums)")
            print(f"{'=' * 70}")

            try:
                forums = load_cqadupstack()

                forum_results = []
                for forum_name, corpus, queries, qrels in forums:
                    print(f"\n  ── CQADupStack/{forum_name} ──")
                    chunks = None
                    try:
                        chunks = build_chunks(corpus)
                        del corpus
                        gc.collect()

                        result = run_single_benchmark(
                            chunks,
                            queries,
                            qrels,
                            f"cqa/{forum_name}",
                            max_queries=args.max_queries,
                            num_workers=args.parallel)
                        forum_results.append(result)

                        # Save partial CQA progress incrementally
                        partial = {
                            "dataset": "cqadupstack_partial",
                            "forums_done": len(forum_results),
                            "forum_details": forum_results,
                            "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
                        }
                        save_results(all_results + [partial])

                    except Exception as e:
                        print(f"    ✗ {forum_name} FAILED: {e}")
                        traceback.print_exc()
                        notify(
                            f"❌ cqa/{forum_name} FAILED",
                            str(e),
                            priority="high")

                    # Ensure cleanup regardless of success/failure
                    chunks = queries = qrels = None
                    gc.collect()

                # Compute CQADupStack average
                if forum_results:
                    avg_result = {
                        "dataset": "cqadupstack",
                        "corpus_size": sum(r["corpus_size"] for r in forum_results),
                        "num_queries": sum(r["num_queries"] for r in forum_results),
                        "num_forums": len(forum_results),
                        "bm25": {
                            "ndcg@10": sum(r["bm25"]["ndcg@10"] for r in forum_results) / len(forum_results),
                            "recall@100": sum(r["bm25"]["recall@100"] for r in forum_results) / len(forum_results),
                            "qps": sum(r["bm25"]["qps"] for r in forum_results) / len(forum_results),
                            "build_time": sum(r["bm25"]["build_time"] for r in forum_results),
                            "total_time": sum(r["bm25"]["total_time"] for r in forum_results),
                        },
                        "bmx": {
                            "ndcg@10": sum(r["bmx"]["ndcg@10"] for r in forum_results) / len(forum_results),
                            "recall@100": sum(r["bmx"]["recall@100"] for r in forum_results) / len(forum_results),
                            "qps": sum(r["bmx"]["qps"] for r in forum_results) / len(forum_results),
                            "build_time": sum(r["bmx"]["build_time"] for r in forum_results),
                            "total_time": sum(r["bmx"]["total_time"] for r in forum_results),
                        },
                        "forum_details": forum_results,
                        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
                    }
                    avg_result["delta"] = {
                        "ndcg@10": avg_result["bmx"]["ndcg@10"] -
                        avg_result["bm25"]["ndcg@10"],
                        "recall@100": avg_result["bmx"]["recall@100"] -
                        avg_result["bm25"]["recall@100"],
                        "speedup": avg_result["bmx"]["qps"] /
                        avg_result["bm25"]["qps"] if avg_result["bm25"]["qps"] > 0 else 0,
                    }
                    all_results.append(avg_result)

                    sign_n = "+" if avg_result["delta"]["ndcg@10"] >= 0 else ""
                    print(
                        f"\n  CQADupStack AVG — NDCG@10 Δ: {sign_n}{
                            avg_result['delta']['ndcg@10']:.4f} | " f"Speedup: {
                            avg_result['delta']['speedup']:.2f}×")

                    save_results(all_results)

            except Exception as e:
                print(f"\n  ✗ CQADupStack FAILED: {e}")
                traceback.print_exc()
                notify(f"❌ CQADupStack FAILED", str(e), priority="high")
                save_results(all_results)

    # ── Final summary ──
    total_elapsed = time.perf_counter() - total_start

    if all_results:
        print_summary_table(all_results)
        print(
            f"  Total wall time: {
                total_elapsed /
                60:.1f} minutes ({
                total_elapsed /
                3600:.1f} hours)")
        print(f"  Results saved to: {RESULTS_FILE}")

        # Final notification with full table
        avg_ndcg = sum(r["delta"]["ndcg@10"]
                       for r in all_results) / len(all_results)
        avg_recall = sum(r["delta"]["recall@100"]
                         for r in all_results) / len(all_results)
        sign_n = "+" if avg_ndcg >= 0 else ""
        sign_r = "+" if avg_recall >= 0 else ""

        table_lines = []
        for r in all_results:
            d = r["delta"]
            sn = "+" if d["ndcg@10"] >= 0 else ""
            table_lines.append(
                f"{r['dataset']:<16} {sn}{d['ndcg@10']:.4f}  {d['speedup']:.1f}×")

        notify(
            "🏁 ALL BENCHMARKS COMPLETE",
            f"Time: {
                total_elapsed /
                3600:.1f}h | {
                len(all_results)} datasets\n" f"Avg NDCG Δ: {sign_n}{
                avg_ndcg:.4f} | Avg R@100 Δ: {sign_r}{
                    avg_recall:.4f}\n" f"────────────────────────\n" +
            "\n".join(table_lines),
            priority="high",
        )
    else:
        print("\n  No results to report.")
        notify(
            "⚠️ Benchmark finished with no results",
            "All datasets skipped or failed",
            priority="high")


if __name__ == "__main__":
    main()

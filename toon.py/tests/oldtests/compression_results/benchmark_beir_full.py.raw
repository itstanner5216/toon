    {"name": "nfcorpus",
     "docs": "3.6K",
     "domain": "Medical/Nutrition",
     "split": "test"},
    {"name": "scifact",
     "docs": "5.2K",
     "domain": "Scientific claims",
     "split": "test"},
    {"name": "arguana",

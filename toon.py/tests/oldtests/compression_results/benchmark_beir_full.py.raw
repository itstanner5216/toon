     "split": "test"},

    # ── Medium (10K – 100K docs) ──
    {"name": "scidocs",
     "docs": "25.7K",
     "domain": "Scientific papers",
     "split": "test"},
    {"name": "fiqa", "docs": "57.6K", "domain": "Financial QA", "split": "test"},

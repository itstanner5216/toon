#!/usr/bin/env python3
"""
Full BEIR Benchmark Suite: BM25 vs BMX+ across ALL publicly available datasets.

Runs all 18 BEIR datasets (14 freely downloadable + CQADupStack's 12 sub-forums).
Saves results incrementally to JSON after each dataset so nothing is lost on crash.

Usage:
    python benchmark_beir_full.py                    # Run all datasets
    python benchmark_beir_full.py --skip-large        # Skip datasets > 1M docs
    python benchmark_beir_full.py --resume             # Skip datasets already in results file
    python benchmark_beir_full.py --datasets fiqa nq   # Run specific datasets only

Results saved to: beir_full_results.json
"""

import argparse
import gc
import json
import multiprocessing as mp
import os
import random
import resource
import shutil
import sys
import time
import traceback
import urllib.request
from pathlib import Path

import pytrec_eval
from beir import util as beir_util
from beir.datasets.data_loader import GenericDataLoader
from bm25 import BM25Index
from bmx_plus import BMXPlusIndex

PROJECT_ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(PROJECT_ROOT))

# Global for fork-based shared index (COW — no memory duplication)
_SHARED_INDEX = None


def _worker_init():
    """Called once per worker process at fork time.
    Disables GC to prevent reference count writes that would trigger COW page faults."""
    gc.disable()


def _search_one(args):
    """Worker: search one query against the shared index."""
    qid, query_text, top_k = args
    hits = _SHARED_INDEX.search(query_text, top_k=top_k)
    return qid, {doc_id: float(score) for doc_id, score in hits}


DATA_DIR = PROJECT_ROOT / "beir_datasets"
RESULTS_FILE = PROJECT_ROOT / "beir_full_results.json"
NTFY_TOPIC = None      # Set via --notify flag
OFFLOAD_TARGET = None   # Set via --offload flag


def get_rss_gb():
    """Get current RSS in GB (Linux-accurate, macOS fallback)."""
    try:
        with open("/proc/self/status") as f:
            for line in f:
                if line.startswith("VmRSS:"):
                    return int(line.split()[1]) / 1_048_576  # KB to GB
    except Exception:
        pass
    # Fallback: peak RSS (macOS returns bytes, Linux returns KB)
    rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
    if sys.platform == "darwin":
        return rss / (1024 ** 3)
    return rss / 1_048_576


def check_disk_space(min_gb: float = 10.0) -> bool:
    """Warn if disk space is low."""
    try:
        usage = shutil.disk_usage("/")
        free_gb = usage.free / (1024 ** 3)
        if free_gb < min_gb:
            msg = f"⚠️ Only {free_gb:.1f}GB disk free (need {min_gb}GB)"
            print(f"  {msg}")
            notify("⚠️ Low disk space", msg, priority="high")
            return False
        print(f"  Disk: {free_gb:.1f}GB free")
        return True
    except Exception:
        return True


def notify(
        title: str,
        message: str,
        priority: str = "default",
        retries: int = 3):
    """Send push notification via ntfy.sh with retry + backoff. Never crashes the benchmark."""
    if not NTFY_TOPIC:
        return
    for attempt in range(retries):
        try:
            req = urllib.request.Request(
                f"https://ntfy.sh/{NTFY_TOPIC}",
                data=message.encode(),
                headers={
                    "Title": title,
                    "Priority": priority,
                    "Tags": "chart_with_upwards_trend",
                },
            )
            urllib.request.urlopen(req, timeout=10)
            return  # Success
        except Exception as e:
            if attempt < retries - 1:
                time.sleep(2 ** attempt)  # Exponential backoff: 1s, 2s, 4s
            else:
                print(f"  ⚠️ ntfy FAILED after {retries} attempts: {e}")


def offload_results():
    """SCP results to local machine. Silent fail — logged but never crashes benchmark."""
    if not OFFLOAD_TARGET:
        return
    try:
        ret = os.system(
            f"scp -q -o ConnectTimeout=15 {RESULTS_FILE} {OFFLOAD_TARGET} 2>/dev/null")
        if ret == 0:
            print(f"  📤 Results offloaded to {OFFLOAD_TARGET}")
        else:
            print(f"  ⚠️ Offload failed (exit {ret}) — results still on VM")
            notify("⚠️ Offload failed", f"SCP returned {ret}", priority="high")
    except Exception as e:
        print(f"  ⚠️ Offload exception: {e}")


# All publicly downloadable BEIR datasets, ordered by corpus size (smallest first)
# Datasets requiring special licenses are excluded: robust04, signal1m,
# bioasq, trec-news
ALL_DATASETS = [
